# 이 파일을 복사해서 .env.local 로 만들고 값을 채워요 (.env.local은 git에 올라가지 않아요).
# 카카오 개발자 콘솔(developers.kakao.com) → 내 애플리케이션 → 앱 키 → REST API 키
# 비워 두면 장소 검색이 src/mocks/place-search.json(가짜 데이터)로 동작해요.
KAKAO_REST_API_KEY=

# 대화에서 회의 조건 뽑기(B, Gemini). 비워 두면 대화방 '@AI 회의 잡아줘'가 예시 흐름으로 동작해요.
# Google AI Studio(aistudio.google.com) → Get API key
GEMINI_API_KEY=
# 비워 두면 B 기본값(gemini-3.1-flash-lite)을 써요
GEMINI_MODEL=

# 로그인 · 팀 · 대화 · 출발지 저장(A, Supabase). 값은 채팅으로 주고받지 않고 각자 직접 넣어요.
# Supabase 대시보드 → Project Settings → API (Project URL, Publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키. 회원 탈퇴(A)와 팀원 출발지 읽기(005 함수)에만 써요. 브라우저 코드·GitHub에 절대 넣지 않아요.
SUPABASE_SERVICE_ROLE_KEY=
